# Copy to web/.env and fill in. web/.env is git-ignored.

# Brevo transactional email (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
# A sender address verified in Brevo, e.g. "Hapax <you@example.com>"
BREVO_SENDER=

# Where the app is served, for the link in the invite email
HAPAX_PUBLIC_URL=http://localhost:8790

# Local development only: lets server/smoke.mjs use @example.test addresses.
# Never set this on a public deployment.
# HAPAX_ALLOW_TEST_EMAIL=1
