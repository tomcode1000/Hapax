{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node render.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/*.mjs": { "maxDuration": 60, "includeFiles": "server/**" }
  },
  "headers": [
    { "source": "/zk/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
